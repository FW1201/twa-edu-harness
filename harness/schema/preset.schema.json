{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/FW1201/twa-edu-harness/harness/schema/preset.schema.json",
  "title": "twa-edu-harness preset 宣告",
  "type": "object",
  "required": ["schemaVersion", "name", "displayName", "description",
               "persona", "skills", "capabilities"],
  "additionalProperties": false,
  "properties": {
    "schemaVersion": { "type": "integer", "const": 1 },
    "name": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$" },
    "displayName": { "type": "string", "minLength": 1 },
    "description": { "type": "string", "minLength": 1 },
    "order": { "type": "integer" },
    "locale": { "type": "string" },
    "persona": { "type": "string", "pattern": "^\\./" },
    "skills": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "include": { "type": "array", "items": { "type": "string" } },
        "exclude": { "type": "array", "items": { "type": "string" } }
      }
    },
    "capabilities": {
      "type": "object",
      "required": ["allow", "deny"],
      "additionalProperties": false,
      "properties": {
        "allow": { "$ref": "#/$defs/capList" },
        "deny":  { "$ref": "#/$defs/capList" }
      }
    },
    "context": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "compaction": { "type": "boolean" },
        "toolResultPruning": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "thresholdChars": { "type": "integer", "minimum": 1 },
            "headChars": { "type": "integer", "minimum": 0 },
            "tailChars": { "type": "integer", "minimum": 0 }
          }
        }
      }
    }
  },
  "$defs": {
    "capList": {
      "type": "array",
      "items": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$" },
      "uniqueItems": true
    }
  }
}
